# Copie este arquivo para .env e preencha os valores antes do deploy
#
#   cp .env.example .env
#   nano .env

# Senha de acesso ao painel /admin
ADMIN_PASSWORD=troque-para-uma-senha-forte

# Chave secreta para assinar os JWT (mínimo 32 caracteres aleatórios)
# Gere uma com: openssl rand -base64 48
JWT_SECRET=troque-para-um-secret-longo-e-aleatorio
